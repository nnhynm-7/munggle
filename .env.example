# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 채우세요.
# 키를 비워두면 "체험 모드(데모)"로 동작합니다. (AI 없이 화면·흐름만 테스트 가능)

# 사용할 AI: gemini(무료 키 가능) / anthropic / openai
LLM_PROVIDER=gemini

# Google Gemini 사용 시 — https://aistudio.google.com/apikey 에서 무료 키 발급
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic(Claude) 사용 시 (유료)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI 사용 시 (유료)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 사람 같은 목소리 (선택) — Microsoft Azure Speech, 무료(F0) 요금제
# 비워두면 브라우저 기본 음성을 씁니다. (Edge 브라우저 음성도 꽤 자연스러워요)
AZURE_SPEECH_KEY=
# 리소스를 만들 때 고른 지역. 예: koreacentral, eastus
AZURE_SPEECH_REGION=
# 여성: ko-KR-SunHiNeural / 남성: ko-KR-InJoonNeural
AZURE_TTS_VOICE=ko-KR-SunHiNeural
# 하루에 읽어줄 최대 글자 수 (무료 한도를 넘지 않게)
TTS_DAILY_CHARS=15000

PORT=3000

# 요청 제한 (API 비용·무료 한도 보호)
# 사용자(IP)당 1분 요청 수
RATE_PER_MINUTE=20
# 서버 전체 하루 AI 호출 수 (넘으면 다음날까지 멈춤)
DAILY_LIMIT=1000
# 로컬은 0, Render/Railway 등에 배포하면 1
TRUST_PROXY=0
